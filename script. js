        <div class="button-row"><a class="btn secondary" href="#specimens">Compare visual specimens <span class="arrow">↗</span></a><a class="btn secondary" href="#fieldnotes">Read field notes <span class="arrow">↗</span></a></div>
      </div>${meta([["RECORD","NS-014"],["CLASSIFICATION","ENTITY / DISPUTED"],["KNOWN FORM","TRIANGULAR MARK"],["STATUS","PARTIAL EXTRACT"],["SOURCE COUNT","INDETERMINATE"],["CANON WARNING","DO NOT INFER MISSING EVENTS"]])}</div>`;
  }
  function paries(){
    return `${heading("RESTRICTED TITLE / 03","The Last <em>Paries.</em>","A title preserved without a dependable beginning. The surviving page refers to a final instance, but not to what is being counted.","NS-021")}
      <div class="two-col"><div class="prose">
        <div class="paries-art"><div class="broken-ring"></div><div class="ring-cut"></div><span class="paries-label">FIG. 021-A // RECONSTRUCTION FROM MARGIN MARKS</span></div>
        <p class="lead">The title appears once in a catalog and twice in notes that claim not to reference the catalog.</p>
        <p><em>Paries</em> is retained exactly as found. The archive has no approved translation. A later annotator added the word “Last” in a different ink, then crossed it out, then wrote it again beside the line.</p>
        <p>No public record establishes whether the phrase refers to a person, a boundary, a remaining structure, or something else entirely. The visual mark shown here is an editorial reconstruction, not evidence of an object.</p>
        <div class="note-box"><strong>ACCESS NOTE / 021</strong>This entry is intentionally incomplete. The absence of context is part of the public record; filling it with invented certainty would make the archive less useful, not more mysterious.</div>
        <h2>Catalog fragment</h2><p>“...the last paries was not the first to be named, only the first whose name remained...”</p><p class="tiny">TRANSCRIPTION STATUS: UNVERIFIED. PUNCTUATION MAY BE EDITORIAL.</p>
        <div class="button-row"><a class="btn secondary" href="#index">Back to index <span class="arrow">↗</span></a><a class="btn secondary" href="#signals">Inspect nearby signal <span class="arrow">⌁</span></a></div>
      </div>${meta([["RECORD","NS-021"],["TITLE STATUS","UNRESOLVED"],["SOURCE","CATALOG MARGIN"],["TRANSLATION","NOT APPROVED"],["INTEGRITY","LOW"],["PUBLIC ACCESS","LIMITED EXTRACT"]])}</div>`;
  }
  function signals(){
    return `${heading("SIGNAL FRAGMENT / 04","Signal / <em>noise.</em>","One message survived the transfer. It has no sender, no timestamp, and a suspicious amount of confidence in whoever finds it.","NS-033")}
      <div class="signal-layout"><section class="signal-card"><div class="eyebrow">TRANSMISSION 033-A</div><h2>It was left in plain sight.</h2><p>The line below was recovered from an index that does not contain this entry. Decode it to reveal the next reference.</p>
        <div class="signal-display"><small>RAW STRING // ENCODING UNKNOWN</small><span id="cipher-text">WKH SDWK GRHV QRW HQG KHUH</span></div>
        <form class="decode-form" id="decode-form"><input id="decode-input" autocomplete="off" placeholder="Enter the decoded phrase…" aria-label="Decoded phrase"><button class="btn" type="submit">Submit <span class="arrow">→</span></button></form><div class="feedback" id="decode-feedback" aria-live="polite"></div>
        <div class="tiny">CAPITALIZATION DOES NOT MATTER. PUNCTUATION IS OPTIONAL. GUESSING IS A VALID RESEARCH METHOD.</div>
      </section><aside class="signal-side"><h3>Operator notes</h3><div class="hint-row"><b>HINT 01 / METHOD</b>Each letter has been moved the same distance through the alphabet.</div><div class="hint-row"><b>HINT 02 / DIRECTION</b>The first letter shown is three steps after the original.</div><div class="hint-row"><b>HINT 03 / RESULT</b>The answer is a sentence, not a name.</div><div class="rule"></div><p class="tiny">If you solve it, a previously unlisted route will be added to your local archive. Your browser stores the discovery; the server receives nothing.</p></aside></div>`;
  }
  function specimens(){
    return `${heading("VISUAL INDEX / 05","Visual <em>specimens.</em>","Marks, diagrams, and shapes associated with surviving public records. These are visual references, not definitive depictions of the things they may describe.","VIS-05")}
      <div class="specimen-grid">
        <article class="specimen"><div class="specimen-art"><div class="threnody-glyph" style="transform:scale(.62)"><i></i></div></div><div class="specimen-body"><small>FIG. 014-A / RECONSTRUCTION</small><h3>Triangular mark</h3><p>Associated with the Threnody record. The form is consistent; the interpretation is not.</p></div></article>
        <article class="specimen"><div class="specimen-art"><div class="glyph-circle"></div></div><div class="specimen-body"><small>FIG. 021-B / EDITORIAL</small><h3>Interrupted circle</h3><p>Derived from a margin mark linked to The Last Paries. Not a verified symbol.</p></div></article>
        <article class="specimen"><div class="specimen-art"><div class="glyph-eye"></div></div><div class="specimen-body"><small>FIG. 033-C / SIGNAL</small><h3>Open eye form</h3><p>Appears in a low-resolution duplicate of a signal card. Source quality is poor.</p></div></article>
        <article class="specimen"><div class="specimen-art"><div class="glyph-columns"><i></i><i></i><i></i><i></i><i></i></div></div><div class="specimen-body"><small>FIG. 052-D / FIELD NOTE</small><h3>Offset columns</h3><p>A simple mark used by one note-taker to represent an order that would not stay fixed.</p></div></article>
        <article class="specimen"><div class="specimen-art"><div class="broken-ring" style="width:88px;height:88px"></div></div><div class="specimen-body"><small>FIG. 067-E / UNKNOWN</small><h3>Boundary study</h3><p>Unclear whether this is a map, a diagram, or someone drawing circles until a thought arrived.</p></div></article>
        <article class="specimen"><div class="specimen-art"><div class="core-symbol" style="transform:scale(.65)"><i></i><span></span></div></div><div class="specimen-body"><small>FIG. 000-F / ARCHIVE</small><h3>Index sigil</h3><p>A decorative mark used by the public archive. It is not confirmed to be part of the fiction.</p></div></article>
      </div><div class="note-box" style="margin-top:25px"><strong>IMAGE POLICY / PUBLIC COPY</strong>Specimens are abstract reconstructions made for navigation and atmosphere. No hidden canonical design is being asserted by their appearance.</div>`;
  }
  function fieldnotes(){
    return `${heading("OBSERVATION LOG / 06","Field <em>notes.</em>","Unpolished observations attached to the archive. They are not official explanations, and the archive has made no effort to make them agree with one another.","FN-06")}
      <div class="notes-grid">
        <article class="field-note"><header><span>NOTE 06.01</span><span>STATUS: OPEN</span></header><h3>On repeated events</h3><p>Two records describe what appears to be the same event. Neither references the other. Similarity alone does not establish a shared history.</p></article>
        <article class="field-note"><header><span>NOTE 06.02</span><span>STATUS: PARTIAL</span></header><h3>On the order of pages</h3><p>The pages have been sorted by filename, then by date, then by an unknown system. None of the resulting orders appears stable.</p></article>
        <article class="field-note"><header><span>NOTE 06.03</span><span>STATUS: DISPUTED</span></header><h3>On the word “appointed”</h3><p>The term is repeated in the Threnody file. One annotation treats it as literal; another calls it metaphor. Neither includes a source.</p></article>
        <article class="field-note"><header><span>NOTE 06.04</span><span>STATUS: OPEN</span></header><h3>On missing entries</h3><p>A gap in a list can be intentional, accidental, or evidence that the list was copied incorrectly. The archive has encountered all three. It does not label them consistently.</p></article>
        <article class="field-note"><header><span>NOTE 06.05</span><span>STATUS: UNVERIFIED</span></header><h3>On the observer</h3><p>Several annotations imply that observation changes what can be recorded. They do not establish whether this is a property of the subject or a problem with the observer.</p></article>
        <article class="field-note"><header><span>NOTE 06.06</span><span>STATUS: REDACTED</span></header><h3>On the last copy</h3><p>The final sentence of the original note was <span class="redacted" title="Hover to reveal">removed from the public copy</span>. The reason for removal is not preserved.</p></article>
      </div>`;
  }
  function about(){
    return `${heading("ADMINISTRATIVE FILE / 07","Project <em>file.</em>","NullShift is a philosophical science-fiction project about reality, time, observation, and the uneasy gap between what happened and what can be known about it.","ADM-07")}
      <div class="two-col"><div class="prose"><p class="lead">This site is a doorway into the project, not a replacement for its underlying canon.</p><p>NullShift uses archive fragments, records, visual clues, and interactive discoveries to let visitors investigate at their own pace. The public archive deliberately withholds major explanations. It is meant to create questions, not hand out a lore dump wearing a trench coat.</p><h2>How to explore</h2><p>Read the index first, then follow whatever catches your attention. Signal fragments may unlock additional public-facing pages. The local ledger tracks discoveries in this browser only; clearing browser data will clear that record.</p><h2>Author</h2><p><strong class="green" style="font-weight:400">Harsheel Mishra</strong><br><span class="tiny">CREATOR / NULLSHIFT</span></p><div class="note-box"><strong>CANON NOTICE</strong>This archive is a public presentation layer. DEV.2 documents remain the authority for canon. A visual clue or editorial phrase on this site should not be treated as a new canonical event unless it is present in the project documents.</div><div class="button-row"><a class="btn secondary" href="https://nullshiftdev-t.github.io" target="_blank" rel="noopener noreferrer">Current public address <span class="arrow">↗</span></a><a class="btn secondary" href="#index">Return to index <span class="arrow">↗</span></a></div></div>${meta([["PROJECT","NULLSHIFT"],["CREATOR","HARSHEEL MISHRA"],["PUBLIC SITE","NULLSHIFTDEV-T.GITHUB.IO"],["PUBLIC COPY","NON-SPOILER"],["CANON BASELINE","DEV.2"],["CONTACT","NOT LISTED HERE"]])}</div>
      <div class="credits"><div class="credit"><small>DESIGN PRINCIPLE 01</small><strong>Atmosphere over exposition.</strong></div><div class="credit"><small>DESIGN PRINCIPLE 02</small><strong>Clues should reward attention.</strong></div><div class="credit"><small>DESIGN PRINCIPLE 03</small><strong>Uncertainty is not permission to invent.</strong></div><div class="credit"><small>DESIGN PRINCIPLE 04</small><strong>The archive is not the whole world.</strong></div></div>`;
  }
  function discovered(){
    if(!state.solved)return `${heading("UNLISTED / ACCESS DENIED","No record <em>found.</em>","This route is not present in the public index. Its absence may be intentional.","UNLISTED")}<div class="empty-state">NO VALID DISCOVERY TOKEN FOUND.<br><br><a class="btn" href="#signals">Return to signal room <span class="arrow">↗</span></a></div>`;
    return `${heading("UNLISTED RECORD / 08","The page <em>between.</em>","This record was not linked from the index. That does not mean it was hidden well.","NS-???")}
      <div class="restricted-banner">UNLISTED ENTRY FOUND // LOCAL DISCOVERY CONFIRMED // CONTENT REMAINS PARTIAL</div>
      <div class="two-col"><div class="prose"><p class="lead">A gap is still part of the sequence.</p><p>The signal did not provide a destination. It provided a direction. Those are not the same thing, although the archive has repeatedly acted as if they were.</p><p>One unindexed annotation has been attached to this route:</p><div class="note-box"><strong>UNSIGNED / NO DATE</strong>“The path does not end here.”</div><p>There is no further text in the recovered copy. No signature. No reliable reference number. The ledger records that you found the route, not that the route has been explained.</p><div class="button-row"><a class="btn secondary" href="#ledger">View your ledger <span class="arrow">↗</span></a><a class="btn secondary" href="#index">Return to the index <span class="arrow">↗</span></a></div></div>${meta([["RECORD","NS-???"],["INDEX STATUS","UNLISTED"],["ACCESS METHOD","SIGNAL 033-A"],["CONTENT","ONE ANNOTATION"],["RELIABILITY","UNKNOWN"],["NEXT REFERENCE","NOT FOUND"]])}</div>`;
  }
  function ledger(){
    const items=state.discoveries;
    return `${heading("LOCAL STORAGE / 09","Your <em>ledger.</em>","A record of what you have opened and found in this browser. It is local, private to this browser, and extremely easy to erase by clearing site data.","LED-09")}
      <div class="metrics"><div class="metric"><b>${String(state.visited.length).padStart(2,"0")}</b><span>ROUTES VISITED</span></div><div class="metric"><b>${String(items.length).padStart(2,"0")}</b><span>DISCOVERIES</span></div><div class="metric"><b>${state.solved?"01":"00"}</b><span>SIGNAL SOLVED</span></div><div class="metric"><b>LOCAL</b><span>STORAGE ONLY</span></div></div>
      <div class="section-head"><h2>Discovery record</h2><span class="tiny">${items.length} ENTRIES</span></div>
      <div class="ledger-list">${items.length?items.map((item,i)=>`<div class="ledger-item"><span class="tick">✓</span><div><strong>${item.label}</strong><small>${item.id}</small></div><time>${new Date(item.time).toLocaleDateString()}</time></div>`).join(""):`<div class="empty-state">NO DISCOVERIES RECORDED YET.<br><br>Start with the signal room. The archive is not going to investigate itself.</div>`}</div>
      <div class="section-head" style="margin-top:35px"><h2>Visited routes</h2><span class="tiny">${state.visited.length} / 09</span></div><div class="ledger-list">${state.visited.length?state.visited.map(r=>`<div class="ledger-item"><span class="tick">·</span><div><strong>${labels[r]||r}</strong><small>ROUTE // ${r.toUpperCase()}</small></div><span class="record-state open">VISITED</span></div>`).join(""):`<div class="empty-state">NO ROUTES LOGGED.</div>`}</div>
      <div class="button-row"><button class="btn secondary" id="ledger-reset" type="button">Clear local ledger <span class="arrow">×</span></button></div><p class="tiny" style="margin-top:14px">This does not delete server data because the site does not send these discoveries to a server. There is no server-side tracking code in this archive.</p>`;
  }
  const renderers={home,index:indexPage,threnody,paries,signals,specimens,fieldnotes,about,discovered,ledger};
  function render(route){
    if(!knownRoutes.includes(route))route="home";
    if(route==="discovered"&&!state.solved)route="signals";
    page.innerHTML=renderers[route]();
    $("#current-label").textContent=labels[route]||"FRONT MATTER";
    $$("#main-nav a").forEach(a=>a.classList.toggle("active",a.dataset.route===route));
    const hidden=$(".restricted-link"); if(hidden)hidden.hidden=!state.solved;
    markVisit(route);
    if(route==="index")setupFilters();
    if(route==="signals")setupSignal();
    if(route==="ledger")setupLedger();
    $("#sidebar").classList.remove("open");$("#menu-toggle").setAttribute("aria-expanded","false");
    page.focus({preventScroll:true});
    if(route==="threnody")discover("NS-014","The Threnody opened");
    if(route==="paries")discover("NS-021","The Last Paries opened");
  }
  function setupFilters(){
    $$(".filter-btn").forEach(btn=>btn.addEventListener("click",()=>{
      $$(".filter-btn").forEach(b=>b.classList.toggle("active",b===btn));
      $$(".index-card").forEach(item=>item.hidden=btn.dataset.filter!=="all"&&item.dataset.category!==btn.dataset.filter);
    }));
  }
  function setupSignal(){
    const form=$("#decode-form"),input=$("#decode-input"),feedback=$("#decode-feedback");
    form.addEventListener("submit",event=>{
      event.preventDefault();
      const answer=input.value.toLowerCase().replace(/[^a-z]/g,"").trim();
      if(answer==="thepathdoesnotendhere"){
        feedback.textContent="MATCH CONFIRMED. UNLISTED ROUTE ADDED TO THE INDEX.";
        state.solved=true;save();discover("SIG-033","Signal 033-A decoded");$("#main-nav .restricted-link").hidden=false;
        toast("SIGNAL DECODED // UNLISTED ROUTE AVAILABLE");
        setTimeout(()=>{location.hash="#discovered";},650);
      }else{
        feedback.textContent="NO MATCH. CHECK THE SHIFT, NOT THE SPELLING OF THE UNIVERSE.";
      }
    });
  }
  function setupLedger(){
    const reset=$("#ledger-reset");if(reset)reset.addEventListener("click",()=>{
      if(confirm("Clear this browser's NullShift discovery ledger?")){
        state={visited:[],discoveries:[],solved:false};save();toast("LOCAL LEDGER CLEARED");render("ledger");
      }
    });
  }
  function openSearch(){const dlg=$("#search-dialog");if(!dlg.open)dlg.showModal();$("#search-input").focus();}
  function searchRecords(query){
    const q=query.trim().toLowerCase();
    if(!q){$("#search-results").innerHTML='<p class="muted">Type to search indexed records.</p>';return;}
    const matches=records.filter(r=>(r.route!=="discovered"||state.solved)&&`${r.id} ${r.title} ${r.type} ${r.desc}`.toLowerCase().includes(q));
    $("#search-results").innerHTML=matches.length?matches.map(r=>`<a class="search-result" href="#${r.route}"><small>${r.id} / ${r.type.toUpperCase()}</small><strong>${r.title}</strong><p>${r.desc}</p></a>`).join(""):'<p class="muted">No public record matched. The archive will not pretend that this is meaningful.</p>';
    $$(".search-result",$("#search-results")).forEach(a=>a.addEventListener("click",()=>$("#search-dialog").close()));
  }
  $("#search-open").addEventListener("click",openSearch);
  $("#search-close").addEventListener("click",()=>$("#search-dialog").close());
  $("#search-input").addEventListener("input",e=>searchRecords(e.target.value));
  $("#menu-toggle").addEventListener("click",()=>{
    const open=$("#sidebar").classList.toggle("open");$("#menu-toggle").setAttribute("aria-expanded",String(open));
  });
  document.addEventListener("keydown",e=>{
    if(e.key==="/"&&!["INPUT","TEXTAREA"].includes(document.activeElement.tagName)){e.preventDefault();openSearch();}
    if(e.key==="Escape")$("#sidebar").classList.remove("open");
  });
  window.addEventListener("hashchange",()=>render(location.hash.slice(1)||"home"));
  $("#footer-time").textContent=`LOCAL CLOCK // ${new Date().toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"})}`;
  updateCounts();
  render(location.hash.slice(1)||"home");
})(); 
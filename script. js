  const initialState = () => {
    try { return JSON.parse(localStorage.getItem("nullshift-ledger-v2")) || {visited:[], discoveries:[], solved:false}; }
    catch { return {visited:[], discoveries:[], solved:false}; }
  };
  let state = initialState();
  let toastTimer;
  function save(){ try{localStorage.setItem("nullshift-ledger-v2",JSON.stringify(state));}catch{} updateCounts(); }
  function updateCounts(){
    $("#indexed-count").textContent = `${String(state.visited.length).padStart(2,"0")} / 09`;
  }
  function toast(message){
    toastEl.textContent=message; toastEl.classList.add("show"); clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>toastEl.classList.remove("show"),2600);
  }
  function markVisit(route){
    if(!state.visited.includes(route)){state.visited.push(route);save();}
  }
  function discover(id,label){
    if(!state.discoveries.some(item=>item.id===id)){
      state.discoveries.push({id,label,time:new Date().toISOString()});save();
      toast(`LEDGER UPDATED // ${id}`);
    }
  }
  function heading(kicker,title,desc,code){
    return `<header class="page-heading"><div><div class="eyebrow">${kicker}</div><h1>${title}</h1><p class="lead">${desc}</p></div><div class="heading-code">${code}<span>PUBLIC COPY / ${new Date().getFullYear()}</span></div></header>`;
  }
  function meta(items){
    return `<aside class="metadata"><div class="metadata-head">RECORD METADATA</div><dl>${items.map(([k,v])=>`<dt>${k}</dt><dd>${v}</dd>`).join("")}</dl></aside>`;
  }
  function row(rec){
    return `<a class="record-row" href="#${rec.route}"><span class="record-no">${rec.id}</span><span><strong>${rec.title}</strong><small>${rec.type}</small></span><span class="record-state ${rec.status==="OPEN"?"open":""}">${rec.status}</span></a>`;
  }
  function card(rec){
    return `<a class="index-card" href="#${rec.route}" data-category="${rec.type}"><div class="card-top"><span>${rec.id}</span><span>${rec.status}</span></div><h3>${rec.title}</h3><p>${rec.desc}</p><div class="card-foot"><span>${rec.type.toUpperCase()}</span><span>OPEN RECORD ↗</span></div></a>`;
  }
  function home(){
    return `<section class="hero">
      <div class="hero-copy"><div class="eyebrow">PUBLIC ARCHIVE // INCOMPLETE BY DESIGN</div>
        <h1><span>Reality has</span><span>an <em>index.</em></span></h1>
        <p class="lead">The index is damaged. The records are partial. Something keeps adding entries that no one remembers filing.</p>
        <div class="button-row"><a class="btn" href="#index">Enter the archive <span class="arrow">↗</span></a><a class="btn secondary" href="#signals">Inspect a signal <span class="arrow">⌁</span></a></div>
        <div class="hero-sub">NO ACCOUNT REQUIRED. NO PROMISE OF CLARITY.</div>
      </div>
      <div class="hero-art" aria-label="Abstract triangular archive sigil"><div class="orbit"></div><div class="orbit-line"></div><div class="core-symbol"><i></i><span></span></div><span class="art-label a">FIG. 00 / UNVERIFIED</span><span class="art-label b">COORDINATES: NULL</span><span class="art-label c">∴ 01—09</span><i class="art-cross x"></i><i class="art-cross y"></i></div>

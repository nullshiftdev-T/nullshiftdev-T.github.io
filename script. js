    about:"PROJECT FILE", discovered:"UNLISTED RECORD", ledger:"YOUR LEDGER"
  };
  const records = [
    {id:"NS-000",title:"Front matter",route:"home",type:"Entry point",status:"OPEN",desc:"A public-facing threshold. Not a summary, and certainly not the whole thing."},
    {id:"NS-014",title:"The Threnody",route:"threnody",type:"Entity record",status:"PARTIAL",desc:"A triangular form, an appointment, and a file that refuses to stay complete."},
    {id:"NS-021",title:"The Last Paries",route:"paries",type:"Restricted record",status:"INCOMPLETE",desc:"A title found in the margin of an otherwise ordinary record. No reliable context."},
    {id:"NS-033",title:"Signal / noise",route:"signals",type:"Signal fragment",status:"OPEN",desc:"One transmission survives. It appears to have been left for someone."},
    {id:"NS-041",title:"Visual specimens",route:"specimens",type:"Image index",status:"OPEN",desc:"Symbols and marks recovered from public-facing records."},
    {id:"NS-052",title:"Field notes",route:"fieldnotes",type:"Observations",status:"PARTIAL",desc:"Short observations from the edge of the archive. Reliability varies."},
    {id:"NS-067",title:"Project file",route:"about",type:"Administrative",status:"OPEN",desc:"A note about the project, its author, and the boundaries of this archive."},

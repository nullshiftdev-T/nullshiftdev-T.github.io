(() => {
  'use strict';

  const page = document.getElementById('page');
  const crumb = document.getElementById('crumb-current');
  const rail = document.getElementById('rail');
  const toast = document.getElementById('toast');
  const searchDialog = document.getElementById('search-dialog');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  const STORAGE_KEY = 'nullshift.publicArchive.v1';

  const records = [
    { id: 'NS-001', title: 'The Axiom', category: 'framework', status: 'Indexed', route: 'index', desc: 'A condition by which the known layers remain distinguishable.', tags: 'axiom structure framework layers' },
    { id: 'NS-004', title: 'The Four Layers', category: 'framework', status: 'Indexed', route: 'index', desc: 'Matter. Pattern. Memory. Awareness.', tags: 'matter pattern memory awareness' },
    { id: 'NS-014', title: 'Hades Sigil', category: 'symbol', status: 'Reference', route: 'gallery', desc: 'A mark associated with transcendence beyond Matter.', tags: 'hades sigil symbol visual' },
    { id: 'NS-021', title: 'The Threnody', category: 'entity', status: 'Restricted extract', route: 'threnody', desc: 'A major presence at the edge of the Foundation Arc.', tags: 'threnody entity encounter foundation' },
    { id: 'NS-022', title: 'The Last Paries', category: 'boundary', status: 'Incomplete', route: 'paries', desc: 'A name retained in the archive. Definition remains unresolved.', tags: 'last paries boundary wall beyond' },
    { id: 'NS-031', title: 'Signal / 03', category: 'signal', status: 'Recoverable', route: 'signals', desc: 'A short transmission preserved without its original header.', tags: 'signal cipher message transmission' },
    { id: 'NS-037', title: 'Realisation', category: 'audio', status: 'Reference only', route: 'fieldnotes', desc: 'A soundtrack reference in the project archive.', tags: 'realisation soundtrack audio music' },
    { id: 'NS-041', title: 'Unlisted Record', category: 'unlisted', status: 'Unindexed', route: 'unlisted', desc: 'A route not present in the public directory.', tags: 'unlisted hidden fragment' }
  ];

  let state = loadState();
  let toastTimer;
  let currentRoute = 'home';

  function loadState() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      return {
        found: Array.isArray(saved.found) ? saved.found : [],
        unlisted: Boolean(saved.unlisted),
        signalSolved: Boolean(saved.signalSolved)
      };
    } catch (_) {
      return { found: [], unlisted: false, signalSolved: false };
    }
  }

  function saveState() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (_) { /* Storage may be unavailable. */ }
    updateProgress();
  }

  function updateProgress() {
    const count = String(state.found.length).padStart(2, '0');
    document.getElementById('rail-record-count').textContent = `${count} / 08`;
    document.querySelectorAll('.hidden-route').forEach(el => el.classList.toggle('hidden-route', !state.unlisted));
    const unlistedLink = document.querySelector('[data-route="unlisted"]');
    if (unlistedLink) unlistedLink.style.display = state.unlisted ? 'flex' : 'none';
  }

  function notify(message) {
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 2800);
  }

  function markFound(id) {
    if (!state.found.includes(id)) {
      state.found.push(id);
      saveState();
      notify(`RECORD ${id} ADDED TO DISCOVERY LOG.`);
    }
  }

  function header(kicker, title, description, stamp = 'PUBLIC EXTRACT') {
    return `<section class="page-head"><div><div class="eyebrow">${kicker}</div><h1 class="page-title">${title}</h1><p class="page-description">${description}</p></div><div class="stamp">${stamp}</div></section>`;
  }

  function sectionHead(title, count = '') {
    return `<div class="section-head"><h2 class="section-title">${title}</h2><span class="section-count">${count}</span></div>`;
  }

  function pageHome() {
    return `
      <section class="home-hero">
        <div class="hero-copy">
          <div class="hero-index">PUBLIC ARCHIVE / ENTRY 000</div>
          <h1 class="hero-title">NULL<span>SHIFT.</span></h1>
          <p class="hero-subtitle">A record of fragments, structures and things that have not been fully accounted for. The index is incomplete by design. What remains is open to inspection.</p>
          <div class="hero-actions"><a class="primary-link" href="#index">ENTER THE INDEX <span>↗</span></a><a class="secondary-link" href="#signals">Locate a signal</a></div>
        </div>
        <div class="hero-art" aria-label="Abstract geometric archive symbol" role="img"><div class="orbit"></div><div class="orbit two"></div><div class="monolith"></div><span class="art-coordinate top">REF. 04 / 07 / ∅</span><span class="art-coordinate bottom">FIG. 001 — UNRESOLVED FORM</span><span class="art-cross a">∴</span><span class="art-cross b">⌁</span></div>
      </section>
      <section class="section-block home-grid">
        <div><div class="section-head"><h2 class="section-title">AVAILABLE ROUTES</h2><span class="section-count">04 PRIMARY ENTRIES</span></div>
          <div class="path-list">
            <a class="path-row" href="#threnody"><span class="path-number">01</span><div><div class="path-name">The Threnody</div><div class="path-desc">A presence at the edge of the known record.</div></div><span class="path-status">Restricted extract</span><span class="path-arrow">↗</span></a>
            <a class="path-row" href="#paries"><span class="path-number">02</span><div><div class="path-name">The Last Paries</div><div class="path-desc">A boundary reference without a complete definition.</div></div><span class="path-status">Incomplete</span><span class="path-arrow">↗</span></a>
            <a class="path-row" href="#signals"><span class="path-number">03</span><div><div class="path-name">Signal Room</div><div class="path-desc">A recoverable transmission. Original header missing.</div></div><span class="path-status">Signal 03</span><span class="path-arrow">↗</span></a>
            <a class="path-row" href="#gallery"><span class="path-number">04</span><div><div class="path-name">Visual Records</div><div class="path-desc">Marks, shapes and diagram fragments.</div></div><span class="path-status">4 references</span><span class="path-arrow">↗</span></a>
          </div>
        </div>
        <aside class="margin-note"><div class="note-mark">∴</div><div class="micro-label">MARGIN NOTE / 001</div><h3>The index is not the archive.</h3><p>Some entries are incomplete. Some are only references to other entries. A missing record is not proof that nothing was recorded.</p><div class="note-index">ANNOTATION STATUS: RETAINED</div></aside>
      </section>
      <section class="section-block"><div class="section-head"><h2 class="section-title">RECENTLY INDEXED</h2><a class="text-link" href="#index">VIEW ALL RECORDS ↗</a></div><div class="index-list">${records.slice(0,4).map(entry => entryRow(entry)).join('')}</div></section>
    `;
  }

  function entryRow(entry) {
    return `<a class="index-entry" href="#${entry.route}" data-entry="${entry.id}"><span class="entry-id">${entry.id}</span><div><div class="entry-name">${entry.title}</div><div class="entry-blurb">${entry.desc}</div></div><span class="entry-status">${entry.status}</span><span class="entry-arrow">↗</span></a>`;
  }

  function pageIndex() {
    markFound('NS-001');
    markFound('NS-004');
    const discovered = records.filter(record => state.found.includes(record.id));
    const ledger = discovered.length
      ? discovered.map(record => `<div class="ledger-item"><span>${record.id}</span><b>${record.title}</b><i>RECORDED</i></div>`).join('')
      : '<p class="empty-state">NO LOCAL DISCOVERIES RECORDED.</p>';
    return `${header('DIRECTORY / 01', 'The <em>Index.</em>', 'A working directory of publicly accessible references. Entries are grouped by the kind of record available, not by presumed importance.', '08 ENTRIES / PARTIAL')}
      <div class="index-toolbar"><div class="filter-group" role="group" aria-label="Filter records"><button class="filter-button active" data-filter="all">All records</button><button class="filter-button" data-filter="entity">Entities</button><button class="filter-button" data-filter="boundary">Boundaries</button><button class="filter-button" data-filter="framework">Framework</button><button class="filter-button" data-filter="signal">Signals</button></div><span class="section-count">SELECT AN ENTRY TO OPEN</span></div>
      <div class="index-list" id="index-list">${records.filter(r => r.id !== 'NS-041' || state.unlisted).map(entryRow).join('')}</div>
      <section class="section-block"><div class="section-head"><h2 class="section-title">LOCAL DISCOVERY LOG</h2><span class="section-count">${String(discovered.length).padStart(2,'0')} / 08 FOUND</span></div><div class="discovery-ledger">${ledger}</div><button class="ledger-reset" id="reset-discoveries" type="button">CLEAR THIS DEVICE'S DISCOVERY LOG</button></section>
      <div class="section-block"><div class="micro-label">INDEX NOTE</div><p class="record-copy">The status shown here describes the state of the public record, not the nature or importance of the subject. An incomplete entry remains incomplete until its source material establishes otherwise.</p></div>`;
  }

  function pageThrenody() {
    markFound('NS-021');
    return `${header('RECORD NS-021 / ENTITY', 'THE <em>THRENODY.</em>', 'The name appears in material associated with the Foundation Arc. The public extract records its presence, not the full account.', 'RESTRICTED EXTRACT')}
      <div class="record-layout"><article class="record-main"><div class="record-art" role="img" aria-label="Abstract triangular Threnody sigil"><div class="threnody-mark"></div><div class="record-art-label"><span>FIG. 021 / FORM NOT TO SCALE</span><span>VISUAL REFERENCE</span></div></div>
        <div class="micro-label">PUBLIC EXTRACT / 01</div><blockquote class="record-quote">“It does not fight.<br><em>It unravels.</em>”</blockquote>
        <div class="record-copy"><p>THRENODY is recorded as a major encounter, but the archive does not classify it as a conventional opponent. Its presence marks a limit in the available descriptions of the known world.</p><p>The expanded dossier associates the name with the four known layers: Matter, Pattern, Memory and Awareness. The public index preserves that connection without reproducing the full encounter record.</p><p>There are competing descriptions in the archive. Guardian. Destroyer. Existential constant. None is sufficient on its own.</p><p class="micro-label">END OF PUBLIC EXTRACT</p></div>
        <a class="text-link" href="#index">← RETURN TO THE INDEX</a>
      </article><aside class="record-aside"><div class="micro-label">RECORD PARTICULARS</div><div class="meta-stack"><div class="meta-item"><span>Designation</span><b>THRENODY</b></div><div class="meta-item"><span>Classification</span><b>META-ENTITY</b></div><div class="meta-item"><span>Additional class</span><b>EXISTENTIAL CONSTANT</b></div><div class="meta-item"><span>Alignment</span><b>NULL</b></div><div class="meta-item"><span>Archive status</span><b>PARTIAL / RESTRICTED</b></div><div class="meta-item"><span>Visual reference</span><b>TRIANGULAR FORM</b></div></div><p class="aside-note">The complete dossier is not reproduced in this public archive. Missing context has not been replaced with speculation.</p><div class="micro-label" style="margin-top:25px">CROSS-REFERENCE</div><p class="aside-note"><a class="text-link" href="#paries">THE LAST PARIES ↗</a><br><br><a class="text-link" href="#gallery">VISUAL RECORDS ↗</a></p></aside></div>`;
  }

  function pageParies() {
    markFound('NS-022');
    return `${header('RECORD NS-022 / BOUNDARY', 'THE LAST <em>PARIES.</em>', 'A major boundary reference in the deeper archive. The name is established. Its complete definition is not.', 'INCOMPLETE RECORD')}
      <div class="record-layout"><article class="record-main"><div class="record-art" role="img" aria-label="Abstract image of an incomplete threshold"><div class="paries-mark"></div><div class="record-art-label"><span>FIG. 022 / BOUNDARY STUDY</span><span>ORIGIN UNCONFIRMED</span></div></div>
        <div class="micro-label">FRAGMENT / 01</div><blockquote class="record-quote">A final boundary.<br><em>An unfinished definition.</em></blockquote>
        <div class="record-copy"><p>The earliest surviving reference contains a name and several missing fields. Later material gives the Paries greater significance, but the archive deliberately does not reduce it to an ordinary physical wall.</p><p>Its exact meaning remains unresolved in the public record. There is no confirmed key, mechanism or complete origin entry available here.</p><p>Do not mistake the absence of a definition for an absence of purpose.</p><p class="micro-label">DEFINITION: WITHHELD / ORIGIN: INCOMPLETE / CONTEXT: PARTIAL</p></div>
        <a class="text-link" href="#signals">LOOK FOR RELATED FRAGMENTS ↗</a>
      </article><aside class="record-aside"><div class="micro-label">RECORD PARTICULARS</div><div class="meta-stack"><div class="meta-item"><span>Designation</span><b>THE LAST PARIES</b></div><div class="meta-item"><span>Record type</span><b>BOUNDARY CONCEPT</b></div><div class="meta-item"><span>Definition</span><b>INCOMPLETE</b></div><div class="meta-item"><span>Origin</span><b>NOT ESTABLISHED</b></div><div class="meta-item"><span>Context</span><b>PARTIAL</b></div><div class="meta-item"><span>Public access</span><b>FRAGMENT ONLY</b></div></div><p class="aside-note">The word is retained exactly as it appears in the canon: PARIES. The archive does not silently rename it.</p><div class="micro-label" style="margin-top:25px">RELATED RECORD</div><p class="aside-note"><a class="text-link" href="#threnody">THE THRENODY ↗</a></p></aside></div>`;
  }

  function pageSignals() {
    markFound('NS-031');
    return `${header('TRANSMISSION / 04', 'The <em>Signal Room.</em>', 'A small collection of transmissions and recovered fragments. The first entry is intact enough to be read, provided the offset is understood.', '1 SIGNAL AVAILABLE')}
      <section class="signal-panel"><div class="signal-top"><span>TX / 03 — HEADER DAMAGED</span><span>ENCODING: CAESAR SHIFT</span></div><div class="signal-code">WKH SDWK GRHV QRW HQG KHUH</div><div class="signal-caption">TEXT RECOVERED FROM A DETACHED BUFFER.<br>THE SHIFT VALUE IS NOT INCLUDED IN THE SOURCE.</div><form class="decode-form" id="decode-form"><input id="decode-input" type="text" placeholder="ENTER DECODED MESSAGE" autocomplete="off" spellcheck="false" aria-label="Decoded message"><button type="submit">VERIFY</button></form><button class="hint-toggle" id="hint-toggle" type="button">[ REQUEST A HINT ]</button><p class="hint-text" id="hint-text">The message has been moved forward by three letters. Move each letter back by the same amount. Spaces remain in place.</p><div class="micro-label" id="decode-feedback" style="margin-top:18px">STATUS: AWAITING INTERPRETATION</div></section>
      <section class="section-block"><div class="section-head"><h2 class="section-title">TRANSMISSION NOTES</h2><span class="section-count">BUFFER 03 / 01</span></div><p class="record-copy">This is a self-contained archive puzzle. It does not require an external tool, account or download. The answer unlocks one additional route in this browser. Discovery progress is stored locally on this device.</p></section>`;
  }

  function pageGallery() {
    markFound('NS-014');
    return `${header('VISUAL COLLECTION / 05', 'Visual <em>Records.</em>', 'Symbols and abstract studies associated with the public-facing archive. These are visual references, not complete explanations.', '04 REFERENCES')}
      <div class="gallery-grid">
        <article class="gallery-item" tabindex="0"><div class="gallery-art layers"><div class="layer-rings"></div></div><div class="gallery-meta"><span>FIG 01 / LAYER STUDY</span><span>OPEN ↗</span></div></article>
        <article class="gallery-item" tabindex="0"><div class="gallery-art sig"><div class="sig-shape"></div></div><div class="gallery-meta"><span>FIG 02 / HADES SIGIL</span><span>REFERENCE</span></div></article>
        <article class="gallery-item" tabindex="0"><div class="gallery-art paries"><div class="paries-mark"></div></div><div class="gallery-meta"><span>FIG 03 / PARIES STUDY</span><span>INCOMPLETE</span></div></article>
        <article class="gallery-item" tabindex="0"><div class="gallery-art coordinates"><div class="coordinate-lines"></div></div><div class="gallery-meta"><span>FIG 04 / COORDINATE TRACE</span><span>UNRESOLVED</span></div></article>
      </div><p class="record-copy">Visual records are deliberately abstracted for this public build. They are not substitutes for the project's original artwork or final in-game assets.</p>`;
  }

  function pageFieldnotes() {
    markFound('NS-037');
    return `${header('DEVELOPMENT / 06', 'Field <em>Notes.</em>', 'A public-facing selection of project notes. This is a development shelf, not a release schedule or a complete production diary.', 'SELECTED NOTES')}
      <div class="notes-list">
        <article class="note-row"><div class="note-date">NOTE / 006</div><div><h3>Systems before explanations</h3><p>NullShift is being shaped around systems that create consequences. The fiction should be something the player encounters, not a lecture placed over the game.</p></div><div class="note-type">Design</div></article>
        <article class="note-row"><div class="note-date">NOTE / 005</div><div><h3>Memory is not a file cabinet</h3><p>Records, identity and recollection are treated as connected ideas. The archive can preserve a trace without claiming that the trace is the whole event.</p></div><div class="note-type">Concept</div></article>
        <article class="note-row"><div class="note-date">NOTE / 004</div><div><h3>Realisation</h3><p>A soundtrack reference retained in the development archive. The public page lists the reference without embedding unreleased audio.</p></div><div class="note-type">Sound</div></article>
        <article class="note-row"><div class="note-date">NOTE / 003</div><div><h3>Fragments are not answers</h3><p>Some public records are intentionally partial. An ARG discovery can add context without automatically becoming a new piece of canon.</p></div><div class="note-type">Archive</div></article>
      </div><div class="micro-label">NO RELEASE DATE IS IMPLIED BY THESE NOTES.</div>`;
  }

  function pageAbout() {
    return `${header('PROJECT / 07', 'A project in <em>progress.</em>', 'NullShift is an independent creative project concerned with systems, reality, memory and the consequences of understanding what holds a world together.', 'PROJECT NOTE')}
      <div class="about-layout"><div class="about-copy"><p>NullShift is being developed as a philosophical simulation experience. Its public archive exists separately from the game itself: a place for selected references, small experiments, visual fragments and optional ARG discoveries.</p><p>The project moves between game design, worldbuilding, interactive systems, sound and visual language. It is not a complete account of the story, and it is not intended to be one.</p><p>The archive is maintained as part of the project's wider creative work. Its public material may change as development continues. Older entries may remain as historical records rather than being rewritten to match every new idea.</p><p class="micro-label">PROJECT STATUS: IN DEVELOPMENT</p></div><aside class="about-card"><div class="micro-label">AUTHOR / PROJECT ID</div><div class="creator">BlankCalyx</div><div class="creator-sub">Independent creator · NullShift</div><p>Game design / systems / narrative structures / sound experiments / interactive archive.</p><div class="meta-stack"><div class="meta-item"><span>Project</span><b>NULLSHIFT</b></div><div class="meta-item"><span>Public archive</span><b>REVISION 02</b></div><div class="meta-item"><span>Public contact</span><b>NOT LISTED</b></div></div></aside></div>`;
  }

  function pageUnlisted() {
    if (!state.unlisted) return `${header('ROUTE NOT FOUND', 'No public <em>entry.</em>', 'This route is not listed in the public directory.', 'UNINDEXED')}`;
    markFound('NS-041');
    return `${header('UNLISTED / NS-041', 'An unlisted <em>record.</em>', 'This page is outside the public directory. Its appearance confirms only that the route was found.', 'LOCAL DISCOVERY')}
      <section class="unlisted-panel"><div class="micro-label">FRAGMENT / 07</div><h2>THE PATH WAS ALREADY THERE.</h2><p class="record-copy">No additional definition has been recovered. The index has registered the visit, but the record itself remains incomplete.</p><div class="meta-stack" style="max-width:500px"><div class="meta-item"><span>Route</span><b>UNLISTED</b></div><div class="meta-item"><span>Discovery</span><b>LOCAL / CONFIRMED</b></div><div class="meta-item"><span>Further context</span><b>NOT AVAILABLE</b></div></div></section>`;
  }

  const pages = {
    home: { label: 'OVERVIEW', render: pageHome },
    index: { label: 'THE INDEX', render: pageIndex },
    threnody: { label: 'THE THRENODY', render: pageThrenody },
    paries: { label: 'THE LAST PARIES', render: pageParies },
    signals: { label: 'SIGNAL ROOM', render: pageSignals },
    gallery: { label: 'VISUAL RECORDS', render: pageGallery },
    fieldnotes: { label: 'FIELD NOTES', render: pageFieldnotes },
    about: { label: 'PROJECT / AUTHOR', render: pageAbout },
    unlisted: { label: 'UNLISTED', render: pageUnlisted }
  };

  function navigate() {
    const requested = (location.hash || '#home').slice(1).split('?')[0];
    const route = pages[requested] ? requested : 'home';
    currentRoute = route;
    crumb.textContent = pages[route].label;
    page.innerHTML = pages[route].render();
    page.focus({ preventScroll: true });
    document.querySelectorAll('.side-nav a[data-route]').forEach(link => link.classList.toggle('active', link.dataset.route === route));
    rail.classList.remove('open');
    window.scrollTo(0, 0);
    updateProgress();
    bindPageInteractions();
  }

  function bindPageInteractions() {
    const indexList = document.getElementById('index-list');
    if (indexList) indexList.addEventListener('click', event => {
      const link = event.target.closest('[data-entry]');
      if (!link) return;
      const record = records.find(item => item.id === link.dataset.entry);
      if (!record || record.route !== 'index') return;
      event.preventDefault();
      markFound(record.id);
      const previewCopy = record.id === 'NS-001'
        ? 'The Axiom is recorded as the condition that permits the known layers to remain distinguishable. This public entry preserves the reference without attempting to describe what lies beyond it.'
        : 'Matter. Pattern. Memory. Awareness. Four known layers, each an incomplete description of existence. The archive keeps the names together and leaves the deeper interpretation to the source material.';
      let preview = document.getElementById('record-preview');
      if (!preview) {
        preview = document.createElement('section');
        preview.id = 'record-preview';
        preview.className = 'preview-panel';
        indexList.insertAdjacentElement('afterend', preview);
      }
      preview.innerHTML = `<div class="micro-label">${record.id} / PUBLIC RECORD</div><h3>${record.title}</h3><p>${previewCopy}</p><div class="preview-footer"><span>STATUS: ${record.status.toUpperCase()}</span><button type="button" id="preview-close">CLOSE RECORD ×</button></div>`;
      document.getElementById('preview-close').addEventListener('click', () => preview.remove());
      preview.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    const filterButtons = document.querySelectorAll('[data-filter]');
    filterButtons.forEach(button => button.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.toggle('active', b === button));
      const filter = button.dataset.filter;
      const visible = records.filter(record => (filter === 'all' || record.category === filter) && (record.id !== 'NS-041' || state.unlisted));
      document.getElementById('index-list').innerHTML = visible.length ? visible.map(entryRow).join('') : '<div class="empty-state">NO RECORDS IN THIS CATEGORY.</div>';
    }));

    const form = document.getElementById('decode-form');
    if (form) form.addEventListener('submit', event => {
      event.preventDefault();
      const answer = document.getElementById('decode-input').value.trim().toLowerCase().replace(/[^a-z ]/g, '').replace(/\s+/g, ' ');
      const feedback = document.getElementById('decode-feedback');
      if (answer === 'the path does not end here') {
        state.signalSolved = true;
        state.unlisted = true;
        saveState();
        feedback.textContent = 'STATUS: MATCH CONFIRMED / ROUTE 08 INDEXED';
        feedback.style.color = 'var(--green-bright)';
        notify('SIGNAL VERIFIED. AN UNLISTED ROUTE HAS APPEARED.');
        const unlistedLink = document.querySelector('[data-route="unlisted"]');
        if (unlistedLink) unlistedLink.style.display = 'flex';
      } else {
        feedback.textContent = 'STATUS: NO MATCH / CHECK THE SHIFT';
        feedback.style.color = 'var(--gold)';
      }
    });

    document.querySelectorAll('.gallery-item').forEach((item, index) => item.addEventListener('click', () => {
      const descriptions = [
        'A reference to the four known layers. Their relation is indexed elsewhere.',
        'HADES SIGIL. Inscription retained in the project archive: AS YOUR MIND TRANSCENDS MATTER.',
        'A study of a boundary concept. This drawing is not a literal map or a complete depiction.',
        'A coordinate trace with no confirmed location attached.'
      ];
      let note = item.querySelector('.gallery-detail');
      if (note) { note.remove(); return; }
      note = document.createElement('p');
      note.className = 'gallery-detail';
      note.textContent = descriptions[index];
      item.appendChild(note);
    }));

    const reset = document.getElementById('reset-discoveries');
    if (reset) reset.addEventListener('click', () => {
      state = { found: [], unlisted: false, signalSolved: false };
      saveState();
      notify('LOCAL DISCOVERY LOG CLEARED.');
      navigate();
    });

    const hint = document.getElementById('hint-toggle');
    if (hint) hint.addEventListener('click', () => {
      const box = document.getElementById('hint-text');
      box.classList.toggle('visible');
      hint.textContent = box.classList.contains('visible') ? '[ HIDE HINT ]' : '[ REQUEST A HINT ]';
    });
  }

  function renderSearch(query) {
    const q = query.trim().toLowerCase();
    if (!q) { searchResults.innerHTML = '<p class="empty-search">Enter a term to begin.</p>'; return; }
    const hits = records.filter(record => `${record.id} ${record.title} ${record.desc} ${record.tags}`.toLowerCase().includes(q) && (record.id !== 'NS-041' || state.unlisted));
    searchResults.innerHTML = hits.length ? hits.map(record => `<a class="search-result" href="#${record.route}" data-search-hit><b>${record.title}</b><span>${record.id} / ${record.status}</span></a>`).join('') : '<p class="empty-search">No matching public records.</p>';
    searchResults.querySelectorAll('[data-search-hit]').forEach(link => link.addEventListener('click', () => searchDialog.close()));
  }

  document.getElementById('search-open').addEventListener('click', () => { searchDialog.showModal(); searchInput.focus(); });
  document.getElementById('search-close').addEventListener('click', () => searchDialog.close());
  searchInput.addEventListener('input', () => renderSearch(searchInput.value));
  document.getElementById('menu-toggle').addEventListener('click', () => rail.classList.toggle('open'));
  document.addEventListener('keydown', event => {
    if (event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName) && !searchDialog.open) { event.preventDefault(); searchDialog.showModal(); searchInput.focus(); }
    if (event.key === 'Escape') rail.classList.remove('open');
  });
  window.addEventListener('hashchange', navigate);
  updateProgress();
  navigate();
})(); 